ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
NODE_ENV=development

# --- CORS ---
# Danh sách origin (cách nhau bởi dấu phẩy) được phép gọi API kèm cookie session từ browser.
# Dev native (Vite proxy /api sang backend) không cần đổi giá trị mặc định. NHƯNG server
# production thật (D:\space-flow-server, lệnh "SERVER" trong CLAUDE.md §11) BẮT BUỘC phải set
# domain thật ở đây (vd CORS_ORIGINS=https://spaceflow.me.uk) — thiếu là mọi request
# POST/PUT/DELETE từ trang thật (kéo-thả file, lưu workflow, đăng nhập...) sẽ bị chặn 500
# (xem docs/issues/2026-08-24-cors-missing-production-origin.md).
CORS_ORIGINS=http://localhost:5174,http://localhost:2612

# --- Đăng nhập Google (Việc 1, specs/hosted-deployment-and-local-agent.md) ---
# Web Client ID tạo ở Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
# Email (cách nhau bởi dấu phẩy) tự động thành Admin khi đăng nhập lần đầu.
ADMIN_EMAILS=

# --- Dev-only: bỏ qua đăng nhập Google khi chạy local (dev.bat tự đăng nhập sẵn) ---
# true = /api/auth/dev-login tạo/dùng lại 1 user admin cố định "dev@space-flow.local", set session
# cookie luôn, không cần Google Client ID. .env KHÔNG được đồng bộ qua lệnh "product"/"SERVER"
# (xem CLAUDE.md §9/§11) nên bật ở máy dev là an toàn — KHÔNG BAO GIỜ bật giá trị này ở .env của
# product/server thật.
DEV_LOGIN_ENABLED=false

# --- Agent-relay (Việc 2) ---
# 'agent' (mặc định) = chạy mọi node kể cả local-only, như hành vi hiện tại.
# 'server' = chỉ chạy node cloud-safe, chuyển node local sang agent của người bấm Run.
SPACE_FLOW_MODE=agent
# Chỉ cần khi SPACE_FLOW_MODE=agent: URL của server trung tâm để dial-out tới.
CENTRAL_SERVER_URL=

# --- Registry signing (Custom Node Platform Phase 7) ---
# Passphrase bảo vệ file khoá ký Ed25519 tự sinh lần đầu dùng
# (backend/registry/signing-key.pem, gitignored — KHÔNG phải chính khoá, chỉ là passphrase mã
# hoá nó). Bắt buộc phải set trước khi Admin bấm "Approve" 1 submission lần đầu tiên trên máy
# này — server.js không tự sinh giá trị mặc định (xem docs/decisions/0029).
SIGNING_KEY_PASSPHRASE=

# --- Credential encryption-at-rest (Sheet Phase 4, specs/space-flow-master-plan/03-spreadsheet.md
# §3 phản biện #7) ---
# Khoá AES-256-GCM mã hoá cột `data` của bảng `credentials` (mọi credential, không riêng Google
# Sheets OAuth token). Chuỗi hex 64 ký tự (32 byte) — tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Chưa set: credential mới vẫn lưu plaintext như trước (không phá vỡ cài đặt hiện có), chỉ log 1
# cảnh báo. Credential cũ (plaintext) vẫn đọc được bình thường sau khi set khoá này — chỉ credential
# ghi/sửa MỚI mới được mã hoá. Đã set rồi thì KHÔNG được đổi/xoá — mất khoá là mất luôn credential
# đã mã hoá bằng khoá đó (không có cách khôi phục), giống nguyên tắc của SIGNING_KEY_PASSPHRASE.
CREDENTIALS_ENCRYPTION_KEY=

# --- Google Sheets: Import once (Sheet Phase 3, specs/space-flow-master-plan/03-spreadsheet.md) ---
# API key (không phải OAuth) để đọc sheet CÔNG KHAI qua spreadsheets.values.batchGet — tạo ở
# Google Cloud Console → APIs & Services → Credentials → API key, bật "Google Sheets API" cho
# project đó. Không dùng để đọc sheet riêng tư (private) — xem GOOGLE_CLIENT_SECRET bên dưới.
GOOGLE_SHEETS_API_KEY=

# --- Google Sheets: OAuth Connect + Linked Read-only (Sheet Phase 4) ---
# Dùng CHUNG Web Client ID ở GOOGLE_CLIENT_ID phía trên, nhưng luồng authorization-code (khác
# luồng "Sign in with Google" ID-token hiện có) cần thêm Client Secret của đúng Client ID đó.
GOOGLE_CLIENT_SECRET=
# Redirect URI đã đăng ký CHO ĐÚNG Client ID này trên Google Cloud Console (Authorized redirect
# URIs). Dev mặc định trỏ thẳng cổng backend (KHÔNG qua Vite proxy — đây là điều hướng trình
# duyệt toàn trang, không phải fetch /api). Server thật (lệnh "SERVER", CLAUDE.md §11) phải đổi
# sang domain thật, vd https://spaceflow.me.uk/api/google-oauth/callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/google-oauth/callback

# --- Video Editor text-overlay font (Phase 4, backend/video/fontResolver.js) ---
# Tuỳ chọn — chỉ cần khi muốn dùng font khác mặc định (Windows: Arial hệ thống; Docker/product:
# DejaVu Sans Bold cài qua Dockerfile.backend). Trỏ tới 1 file .ttf tồn tại thật trên máy chạy
# backend/agent.
# SPACE_FLOW_DRAWTEXT_FONT=

# --- Web Folder Browser (chỉ áp dụng khi chạy Docker/product) ---
# %USERPROFILE% được mount tự động, không cần khai báo gì.
# Muốn thêm tối đa 3 thư mục khác làm root duyệt trong modal (vd ổ D:, thư mục dự án khác):
# EXTRA_HOST_DIR_1=D:\MyProjects
# EXTRA_HOST_DIR_2=
# EXTRA_HOST_DIR_3=
