ANTHROPIC_API_KEY=sk-ant-...
PORT=3001
NODE_ENV=development

# --- Đăng nhập Google (Việc 1, specs/hosted-deployment-and-local-agent.md) ---
# Web Client ID tạo ở Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
# Email (cách nhau bởi dấu phẩy) tự động thành Admin khi đăng nhập lần đầu.
ADMIN_EMAILS=

# --- Agent-relay (Việc 2) ---
# 'agent' (mặc định) = chạy mọi node kể cả local-only, như hành vi hiện tại.
# 'server' = chỉ chạy node cloud-safe, chuyển node local sang agent của người bấm Run.
SPACE_FLOW_MODE=agent
# Chỉ cần khi SPACE_FLOW_MODE=agent: URL của server trung tâm để dial-out tới.
CENTRAL_SERVER_URL=

# --- Web Folder Browser (chỉ áp dụng khi chạy Docker/product) ---
# %USERPROFILE% được mount tự động, không cần khai báo gì.
# Muốn thêm tối đa 3 thư mục khác làm root duyệt trong modal (vd ổ D:, thư mục dự án khác):
# EXTRA_HOST_DIR_1=D:\MyProjects
# EXTRA_HOST_DIR_2=
# EXTRA_HOST_DIR_3=
