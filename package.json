{
  "name": "space-flow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node server.js",
    "dev:frontend": "cd frontend && npx vite",
    "setup": "node scripts/check-env.js && npm install --prefix frontend && npm install --prefix backend && npm install --prefix nodes",
    "setup:python": "pip install rembg Pillow requests certifi google-cloud-storage yt-dlp curl_cffi gdown==6.1.0 bandit faster-whisper==1.2.1 numpy",
    "setup:speech": "python nodes/local-speech/setup.py",
    "review:open": "node scripts/review-console-start.js",
    "review:worker": "node scripts/review-console.js worker",
    "review:doctor": "node scripts/review-console.js doctor",
    "review:install": "node scripts/install-review-console.js",
    "review:sandbox": "node scripts/review-console.js sandbox-setup"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2",
    "exceljs": "^4.4.0"
  }
}
