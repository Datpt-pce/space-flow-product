      "id": "unc_links",
      "label": "Folder links",
      "type": "array"
    },
    {
      "id": "files_out",
      "label": "Videos",
      "type": "array"
    },
    {
      "id": "thumbnail_files",
      "label": "Thumbnails",
      "type": "array"
    },
    {
      "id": "recognized_items",
      "label": "Source metadata",
      "type": "array"
    },
    {
      "id": "drive_links",
      "label": "Reported folder paths",
      "type": "array"
    }
  ],
  "config": [
