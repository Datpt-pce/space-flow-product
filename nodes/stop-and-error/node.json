{
  "id": "stop-and-error",
  "name": "Stop And Error",
  "version": "1.0.0",
  "category": "control",
  "description": "Chủ động dừng workflow với 1 lỗi tuỳ ý — dùng làm guard-clause/assertion. Không có output port nào (throw luôn).",
  "icon": "octagon-x",
  "inputs": [
    { "id": "items", "label": "Items", "type": "array" }
  ],
  "outputs": [],
