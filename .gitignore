.env
secret.iss
node_modules/
frontend/node_modules/
backend/node_modules/
backend/uploads/
backend/workflows/
backend/registry-installs/
backend/registry/local-drafts/
backend/registry-submissions/
backend/registry/signing-key.pem
dist/
*.log
# esbuild output for the Graph/Sheet Phase 0 spikes — regenerate with the esbuild command noted
# at the top of each spike.js, not meant to be committed.
frontend/src/graph/spike/spike.bundle.js
frontend/src/sheet/spike/spike.bundle.js
frontend/src/sheet/spike/spike.css
__pycache__/
test-results/
playwright-report/
tests/e2e/.auth/
*.pyc
.DS_Store

# resize-upload node — chứa secret (Asana PAT, GCS credentials path) và catalog nội bộ
nodes/resize-upload/settings.json
nodes/resize-upload/custom_links.json

# credentials store dùng chung cho node gọi API (vd http-request) — chứa secret thật
backend/credentials/store.json

# local AI service registry (Ollama/ComfyUI base URL...) — per-machine, không phải secret
# nhưng port/URL khác nhau giữa các máy nên không commit
backend/config/local-services.json

# agent pairing token — per-machine secret (Phase 2.2 agent mode)
backend/config/agent.json
backend/config/review-console.json
backend/config/review-workspace/
backend/config/review-targets.json

# media delivery job state — per-machine (machine ID + local file paths), not source
backend/config/media-machine-id
backend/config/media-deliveries/

# app DB — users/sessions/workflows/agents/credentials, per-deployment state
backend/db/space-flow.sqlite
backend/db/space-flow.sqlite-wal
backend/db/space-flow.sqlite-shm

# module-tool-python resize/upload tool — chứa secret (Asana PAT, GCS service account key)
module-tool-python/resize_uploadCloud-NMS-youtube/config.json
module-tool-python/resize_uploadCloud-NMS-youtube/config222.json
module-tool-python/resize_uploadCloud-NMS-youtube/custom_links.json

# === Harness ===
# Harness durable layer — each project instance generates its own data.
harness.db
harness.db-wal
harness.db-shm
.harness/epoch-transition/writer.lock

# Readiness state snapshots and relocated native data are deployment-owned.
backend/db/*.pre-migration-*.sqlite
backend/db/*.pre-key-rotation-*.sqlite
backend/db/*.schema-sha256
backend/db/*.backup-status.json
backend/state/

# Rust build output for harness tooling.
target/
dist/

# Downloaded Harness CLI binary for installed project instances.
scripts/bin/harness-cli
scripts/bin/harness-cli.exe

# CodeGraph runtime state — changes constantly, causes pull conflicts.
.codegraph/

# Compiled installer output (build artifact, not source)
dist-installer/

# Uninstaller do Inno Setup tu tao trong thu muc cai dat (setup.iss) - khong phai source
unins*.dat
unins*.exe

# Debug/validation artifacts (proof videos, run logs) generated during a session - not source
logs/
# draw.io recovery drafts belong to the open editor, not source control.
draw-io/.*.drawio.dtmp
